    "#Largest among the 3 numbers\n",
    "\n",
    "a=float(input(\"Enter a\"))\n",
    "b=float(input(\"Enter b\"))\n",
    "c=float(input(\"Enter c\"))\n",
    "if a>b and a>c:\n",
    "   print(\"a is the largest number\", a)\n",
    "    \n",
    "elif b>a and b>c :\n",
    "  print(\"b is the largest number\", b)\n",
    "\n",
    "else :\n",
    "  print(\"c is the largest number\", c)"
   ]
